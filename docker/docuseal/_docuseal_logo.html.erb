<%# Cue signing-header customization. Original DocuSeal attribution retained. %>
<div style="margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 12px">
  <img src="/cue-branding/tbn-logo.png" alt="TBN" width="180" height="60" style="display:block;width:180px;max-width:60vw;height:auto">
  <a href="<%= root_path %>" style="display:flex;align-items:center;gap:6px;color:inherit;font-size:14px;text-decoration:none">
    <span>Powered by</span>
    <%= render 'shared/logo', class: 'w-5 h-5' %>
    <span style="font-weight:600"><%= Docuseal.product_name %></span>
  </a>
  <a href="/cue-branding/docuseal-source.tar.gz" style="font-size:12px;color:inherit;text-decoration:underline">Signing software source</a>
</div>
